---
const services = [
	{ num: '01', title: 'Custom Furniture', desc: 'Bespoke pieces designed and crafted to fit your space and style perfectly.' },
	{ num: '02', title: 'Cabinet Making', desc: 'Precision-built cabinetry for kitchens, offices, and every room between.' },
	{ num: '03', title: 'Home Renovations', desc: 'Full-scope woodworking for renovations that transform how you live.' },
	{ num: '04', title: 'Repairs & Restoration', desc: 'Breathing new life into cherished pieces with careful, expert hands.' },
	{ num: '05', title: 'Custom Design', desc: 'Collaborative process from first sketch to finished piece — your vision, our craft.' },
	{ num: '06', title: 'Commercial Projects', desc: 'Large-scale installations for hospitality, retail, and office environments.' },
];
---

<section id="services">
	<div class="container">
		<div class="services-header">
			<span class="eyebrow">What We Do</span>
			<h2>Our Services</h2>
		</div>
		<div class="services-list">
			{services.map(s => (
				<a href="#contact" class="service-row">
					<span class="service-num">{s.num}</span>
					<div class="service-info">
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
					<span class="service-arrow">→</span>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	#services {
		background-color: var(--color-surface);
		padding: var(--spacing-xl) 0;
	}

	.services-header {
		margin-bottom: var(--spacing-lg);
	}

	.services-header h2 {
		color: var(--color-ink);
		margin: 0;
	}

	.services-list {
		border-top: 1px solid var(--color-rule);
	}

	.service-row {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		padding: 1.75rem 0;
		border-bottom: 1px solid var(--color-rule);
		color: var(--color-text);
		transition: background-color 0.2s ease, padding 0.2s ease;
		border-radius: var(--border-radius);
	}

	.service-row:hover {
		background-color: rgba(201, 168, 76, 0.06);
		padding-left: 1rem;
		padding-right: 1rem;
		margin: 0 -1rem;
	}

	.service-num {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 0.8rem;
		color: var(--color-amber);
		opacity: 0.6;
		width: 2rem;
		flex-shrink: 0;
	}

	.service-info {
		flex: 1;
	}

	.service-info h3 {
		font-size: 1.2rem;
		color: var(--color-ink);
		margin-bottom: 0.3rem;
		transition: color 0.2s ease;
	}

	.service-row:hover .service-info h3 {
		color: var(--color-amber);
	}

	.service-info p {
		font-size: 0.88rem;
		color: var(--color-muted);
		margin: 0;
		line-height: 1.55;
	}

	.service-arrow {
		font-size: 1.2rem;
		color: var(--color-amber);
		opacity: 0;
		transform: translateX(-10px);
		transition: all 0.25s ease;
		flex-shrink: 0;
	}

	.service-row:hover .service-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	@media (max-width: 600px) {
		.service-row {
			gap: var(--spacing-sm);
		}

		.service-row:hover {
			padding-left: 0.5rem;
			padding-right: 0.5rem;
			margin: 0 -0.5rem;
		}
	}
</style>
