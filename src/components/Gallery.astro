---
const count = 6;
---

<section id="gallery">
	<div class="container">
		<div class="gallery-header">
			<div>
				<span class="eyebrow">Portfolio</span>
				<h2>Our Work</h2>
			</div>
			<a href="#" class="insta-link">
				<span>Follow on Instagram</span>
				<span class="insta-arrow">→</span>
			</a>
		</div>
		<div class="gallery-grid">
			{Array.from({ length: count }, (_, i) => (
				<div class="gallery-item">
					<div class="gallery-inner">
						<span class="gallery-label">Project {i + 1}</span>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	#gallery {
		background-color: var(--color-cream);
		padding: var(--spacing-xl) 0;
	}

	.gallery-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: var(--spacing-lg);
	}

	.gallery-header h2 {
		color: var(--color-ink);
		margin: 0;
	}

	.insta-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-amber);
		transition: gap 0.2s ease;
	}

	.insta-link:hover {
		gap: 0.85rem;
	}

	.insta-arrow {
		transition: transform 0.2s ease;
	}

	.insta-link:hover .insta-arrow {
		transform: translateX(3px);
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
	}

	.gallery-item {
		aspect-ratio: 1;
		overflow: hidden;
		position: relative;
		cursor: pointer;
	}

	.gallery-inner {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, #1c0f06 0%, #2e1a0c 40%, #1c0f06 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.5s ease;
	}

	.gallery-item:hover .gallery-inner {
		transform: scale(1.04);
	}

	.gallery-label {
		font-size: 0.65rem;
		font-weight: 500;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: rgba(245, 237, 216, 0.18);
		transition: color 0.3s ease;
	}

	.gallery-item:hover .gallery-label {
		color: rgba(245, 237, 216, 0.35);
	}

	@media (max-width: 768px) {
		.gallery-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.gallery-header {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--spacing-sm);
		}
	}
</style>
