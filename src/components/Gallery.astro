---
---

<section id="gallery">
	<div class="container">
		<h2>Our Work</h2>
		<p class="gallery-subtitle">Follow us on Instagram to see our latest projects</p>
		
		<div class="instagram-notice">
			<p><strong>Instagram gallery integration</strong></p>
			<p class="notice-text">To complete the Instagram integration, you'll need to:</p>
			<ol>
				<li>Install the loader: <code>npm install astro-loader-ins-medias</code></li>
				<li>Configure it in your astro.config.mjs</li>
				<li>Add your Instagram username and fetch the media</li>
			</ol>
		</div>

		<!-- Placeholder gallery grid -->
		<div class="gallery-grid">
			<div class="gallery-item">
				<div class="placeholder">Project 1</div>
			</div>
			<div class="gallery-item">
				<div class="placeholder">Project 2</div>
			</div>
			<div class="gallery-item">
				<div class="placeholder">Project 3</div>
			</div>
			<div class="gallery-item">
				<div class="placeholder">Project 4</div>
			</div>
			<div class="gallery-item">
				<div class="placeholder">Project 5</div>
			</div>
			<div class="gallery-item">
				<div class="placeholder">Project 6</div>
			</div>
		</div>
	</div>
</section>

<style>
	#gallery {
		background-color: var(--color-light);
	}

	#gallery h2 {
		text-align: center;
		color: var(--color-primary);
	}

	.gallery-subtitle {
		text-align: center;
		color: var(--color-gray);
		font-size: 1.1rem;
		margin-bottom: var(--spacing-md);
	}

	.instagram-notice {
		background-color: var(--color-white);
		padding: var(--spacing-md);
		border-radius: var(--border-radius);
		border-left: 4px solid var(--color-accent);
		margin-bottom: var(--spacing-lg);
	}

	.instagram-notice p {
		margin-bottom: var(--spacing-sm);
	}

	.instagram-notice .notice-text {
		font-weight: 600;
		margin-top: var(--spacing-sm);
	}

	.instagram-notice ol {
		margin-left: var(--spacing-md);
		color: var(--color-gray);
	}

	.instagram-notice code {
		background-color: var(--color-light-gray);
		padding: 2px 6px;
		border-radius: 4px;
		font-family: 'Courier New', monospace;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: var(--spacing-sm);
		margin-top: var(--spacing-md);
	}

	.gallery-item {
		position: relative;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: var(--border-radius);
		background-color: var(--color-white);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
		transition: transform 0.3s ease;
	}

	.gallery-item:hover {
		transform: scale(1.05);
	}

	.placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, var(--color-light-gray) 0%, var(--color-light) 100%);
		color: var(--color-gray);
		font-weight: 600;
	}

	@media (max-width: 768px) {
		.gallery-grid {
			grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		}
	}
</style>
