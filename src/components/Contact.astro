---
---

<section id="contact">
	<div class="contact-split">
		<div class="contact-left">
			<div class="contact-left-inner">
				<span class="eyebrow">Get in Touch</span>
				<h2>Let's Build<br>Something<br>Together.</h2>
				<div class="contact-details">
					<div class="detail">
						<span class="detail-label">Address</span>
						<p>123 Woodworking Lane<br>Craftsville, CS 12345</p>
					</div>
					<div class="detail">
						<span class="detail-label">Phone</span>
						<p>(555) 123-4567</p>
					</div>
					<div class="detail">
						<span class="detail-label">Email</span>
						<p>info@knightswoodworks.com</p>
					</div>
					<div class="detail">
						<span class="detail-label">Hours</span>
						<p>Mon–Fri: 8am–6pm<br>Sat: 9am–4pm</p>
					</div>
				</div>
			</div>
		</div>
		<div class="contact-right">
			<form class="contact-form">
				<div class="form-row">
					<div class="form-group">
						<label for="name">Name</label>
						<input type="text" id="name" name="name" placeholder="Jane Smith" required />
					</div>
					<div class="form-group">
						<label for="email">Email</label>
						<input type="email" id="email" name="email" placeholder="jane@example.com" required />
					</div>
				</div>
				<div class="form-group">
					<label for="phone">Phone</label>
					<input type="tel" id="phone" name="phone" placeholder="(555) 000-0000" />
				</div>
				<div class="form-group">
					<label for="project">Project Type</label>
					<select id="project" name="project">
						<option value="">Select a service</option>
						<option value="furniture">Custom Furniture</option>
						<option value="cabinets">Cabinet Making</option>
						<option value="renovation">Home Renovations</option>
						<option value="repairs">Repairs & Restoration</option>
						<option value="design">Custom Design</option>
						<option value="commercial">Commercial Projects</option>
					</select>
				</div>
				<div class="form-group">
					<label for="message">Tell us about your project</label>
					<textarea id="message" name="message" rows="5" placeholder="Describe what you have in mind..." required></textarea>
				</div>
				<button type="submit">Send Message →</button>
			</form>
		</div>
	</div>
</section>

<style>
	#contact {
		padding: 0;
	}

	.contact-split {
		display: grid;
		grid-template-columns: 5fr 6fr;
		min-height: 700px;
	}

	.contact-left {
		background-color: var(--color-ink);
		display: flex;
		align-items: flex-end;
		padding: var(--spacing-xl) clamp(var(--spacing-md), 5vw, var(--spacing-lg));
	}

	.contact-left-inner {
		max-width: 400px;
	}

	.contact-left .eyebrow {
		color: var(--color-amber);
	}

	.contact-left h2 {
		font-size: clamp(2.5rem, 4.5vw, 3.75rem);
		color: var(--color-cream);
		margin-bottom: var(--spacing-lg);
		line-height: 1.0;
	}

	.contact-details {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-md);
	}

	.detail-label {
		display: block;
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-amber);
		margin-bottom: 0.4rem;
	}

	.detail p {
		font-size: 0.88rem;
		color: rgba(245, 237, 216, 0.55);
		line-height: 1.6;
		margin: 0;
	}

	.contact-right {
		background-color: var(--color-surface);
		display: flex;
		align-items: center;
		padding: var(--spacing-xl) clamp(var(--spacing-md), 5vw, var(--spacing-lg));
	}

	.contact-form {
		width: 100%;
		max-width: 520px;
	}

	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--spacing-sm);
	}

	.form-group {
		margin-bottom: 1.25rem;
	}

	.form-group label {
		display: block;
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--color-ink);
		margin-bottom: 0.45rem;
	}

	.form-group input,
	.form-group select,
	.form-group textarea {
		width: 100%;
		padding: 0.8rem 1rem;
		background-color: var(--color-white);
		border: 1.5px solid var(--color-light-gray);
		border-radius: var(--border-radius);
		font-family: inherit;
		font-size: 0.9rem;
		color: var(--color-text);
		transition: border-color 0.2s ease;
		-webkit-appearance: none;
		appearance: none;
	}

	.form-group input::placeholder,
	.form-group textarea::placeholder {
		color: rgba(26, 15, 6, 0.3);
	}

	.form-group input:focus,
	.form-group select:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: var(--color-amber);
	}

	.form-group textarea {
		resize: vertical;
	}

	.contact-form button[type="submit"] {
		width: 100%;
		padding: 1rem var(--spacing-md);
		background-color: var(--color-ink);
		color: var(--color-cream);
		border: none;
		border-radius: var(--border-radius);
		font-family: inherit;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		cursor: pointer;
		margin-top: 0.5rem;
		transition: background-color 0.2s ease;
	}

	.contact-form button[type="submit"]:hover {
		background-color: var(--color-amber);
	}

	@media (max-width: 900px) {
		.contact-split {
			grid-template-columns: 1fr;
		}

		.contact-left {
			align-items: flex-start;
			padding: var(--spacing-lg) clamp(var(--spacing-sm), 5vw, var(--spacing-md));
		}

		.contact-left h2 {
			margin-bottom: var(--spacing-md);
		}
	}

	@media (max-width: 600px) {
		.form-row {
			grid-template-columns: 1fr;
		}

		.contact-details {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const form = document.querySelector('.contact-form') as HTMLFormElement;
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		alert('Thank you! We will be in touch shortly.');
		form.reset();
	});
</script>
