---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
	<video class="hero-video" autoplay loop muted playsinline>
		<source src={`${base}assets/wood_working_header.mp4`} type="video/mp4" />
	</video>
	<div class="hero-overlay"></div>
	<div class="hero-content">
		<span class="hero-eyebrow">Est. · Knights Wood Works</span>
		<h1>Crafting<br>Excellence<br>in Wood.</h1>
		<div class="hero-footer">
			<p class="hero-sub">Custom woodworking for homes and businesses, built to last a lifetime.</p>
			<a href="#contact" class="hero-cta">Get a Quote</a>
		</div>
	</div>
	<div class="hero-scroll-indicator">
		<span>Scroll</span>
		<div class="scroll-line"></div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		height: 100vh;
		min-height: 600px;
		overflow: hidden;
		color: var(--color-cream);
	}

	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: 0;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(
			160deg,
			rgba(20, 24, 32, 0.25) 0%,
			rgba(20, 24, 32, 0.1) 30%,
			rgba(20, 24, 32, 0.65) 75%,
			rgba(20, 24, 32, 0.92) 100%
		);
	}

	.hero-content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		height: 100%;
		padding: calc(var(--header-height) + var(--spacing-sm)) clamp(var(--spacing-sm), 5vw, var(--spacing-md)) calc(var(--spacing-lg) + 11.85rem);
		max-width: calc(var(--max-width) + 4rem);
		margin: 0 auto;
		width: 100%;
	}

	.hero-eyebrow {
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--color-amber-light);
		margin-bottom: 1.5rem;
		opacity: 0.85;
	}

	.hero h1 {
		font-size: clamp(4rem, 9.5vw, 9rem);
		line-height: 0.93;
		margin-bottom: var(--spacing-md);
		letter-spacing: -0.025em;
	}

	.hero-footer {
		display: flex;
		align-items: flex-end;
		gap: var(--spacing-lg);
	}

	.hero-sub {
		max-width: 280px;
		font-size: 0.9rem;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.65);
		margin: 0;
	}

	.hero-cta {
		display: inline-block;
		border: 1.5px solid rgba(255, 255, 255, 0.45);
		color: var(--color-cream);
		padding: 1rem 2.25rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		white-space: nowrap;
		flex-shrink: 0;
		transition: all 0.25s ease;
	}

	.hero-cta:hover {
		background-color: var(--color-amber);
		border-color: var(--color-amber);
		color: var(--color-cream);
	}

	.hero-scroll-indicator {
		position: absolute;
		bottom: var(--spacing-md);
		right: clamp(var(--spacing-sm), 5vw, var(--spacing-md));
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		color: rgba(255, 255, 255, 0.45);
	}

	.hero-scroll-indicator span {
		font-size: 0.58rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		writing-mode: vertical-rl;
	}

	.scroll-line {
		width: 1px;
		height: 52px;
		background: linear-gradient(to bottom, rgba(255, 255, 255, 0.45), transparent);
		animation: scrollPulse 2.5s ease-in-out infinite;
	}

	@keyframes scrollPulse {
		0%, 100% { opacity: 0.3; transform: scaleY(0.5); transform-origin: top; }
		50% { opacity: 1; transform: scaleY(1); transform-origin: top; }
	}

	@media (max-width: 768px) {
		.hero-footer {
			flex-direction: column;
			align-items: flex-start;
			gap: var(--spacing-md);
		}

		.hero-scroll-indicator {
			display: none;
		}
	}
</style>
