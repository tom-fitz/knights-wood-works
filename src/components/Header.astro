---
const base = import.meta.env.BASE_URL;
---

<header id="site-header">
	<div class="container">
		<nav>
			<a href="/" class="logo">
				<img src={`${base}/assets/knight_facing_right.png`} alt="" />
				<span>Knights Wood Works</span>
			</a>
			<ul class="nav-links">
				<li><a href="#about">About</a></li>
				<li><a href="#services">Services</a></li>
				<li><a href="#gallery">Gallery</a></li>
				<li><a href="#contact">Contact</a></li>
			</ul>
			<a href="#contact" class="nav-cta">Get a Quote</a>
			<button class="mobile-toggle" aria-label="Toggle menu">
				<span></span>
				<span></span>
				<span></span>
			</button>
		</nav>
	</div>
	<div class="mobile-nav">
		<ul>
			<li><a href="#about">About</a></li>
			<li><a href="#services">Services</a></li>
			<li><a href="#gallery">Gallery</a></li>
			<li><a href="#contact">Contact</a></li>
			<li><a href="#contact" class="mobile-cta">Get a Quote</a></li>
		</ul>
	</div>
</header>

<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		padding: 1.5rem 0;
		transition: background-color 0.4s ease, padding 0.3s ease;
	}

	header.scrolled {
		background-color: var(--color-ink);
		padding: 1rem 0;
	}

	nav {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: var(--color-cream);
		margin-right: auto;
	}

	.logo img {
		height: 36px;
		width: auto;
		filter: brightness(0) invert(1);
		opacity: 0.9;
	}

	.logo span {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 1.15rem;
		font-weight: 700;
		white-space: nowrap;
	}

	.nav-links {
		display: flex;
		list-style: none;
	}

	.nav-links a {
		display: block;
		padding: 0.4rem 1rem;
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.65);
		transition: color 0.2s ease;
	}

	.nav-links a:hover,
	.nav-links li.active a {
		color: var(--color-cream);
	}

	.nav-cta {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-cream);
		border: 1px solid rgba(255, 255, 255, 0.35);
		padding: 0.6rem 1.25rem;
		white-space: nowrap;
		transition: all 0.2s ease;
	}

	.nav-cta:hover {
		background-color: var(--color-amber);
		border-color: var(--color-amber);
	}

	.mobile-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.25rem;
		margin-left: auto;
	}

	.mobile-toggle span {
		display: block;
		width: 22px;
		height: 1.5px;
		background-color: var(--color-cream);
		transition: all 0.3s ease;
	}

	.mobile-nav {
		display: none;
		background-color: var(--color-ink);
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.mobile-nav ul {
		list-style: none;
		padding: 0.5rem 0 1rem;
	}

	.mobile-nav li a {
		display: block;
		padding: 0.85rem clamp(var(--spacing-sm), 5vw, var(--spacing-md));
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.65);
		transition: color 0.2s ease;
	}

	.mobile-nav li a:hover {
		color: var(--color-cream);
	}

	.mobile-cta {
		color: var(--color-amber) !important;
	}

	.mobile-nav.open {
		display: block;
	}

	@media (max-width: 768px) {
		.nav-links,
		.nav-cta {
			display: none;
		}

		.mobile-toggle {
			display: flex;
		}
	}
</style>

<script>
	const header = document.getElementById('site-header');
	const toggle = document.querySelector('.mobile-toggle');
	const mobileNav = document.querySelector('.mobile-nav');

	window.addEventListener('scroll', () => {
		header?.classList.toggle('scrolled', window.scrollY > 60);
	});

	toggle?.addEventListener('click', () => {
		mobileNav?.classList.toggle('open');
	});

	mobileNav?.querySelectorAll('a').forEach(link => {
		link.addEventListener('click', () => {
			mobileNav.classList.remove('open');
		});
	});

	const sections = document.querySelectorAll('section[id]');
	const navItems = document.querySelectorAll('.nav-links li');

	window.addEventListener('scroll', () => {
		let current = '';
		sections.forEach(section => {
			if (window.scrollY >= (section as HTMLElement).offsetTop - 120) {
				current = section.getAttribute('id') || '';
			}
		});
		navItems.forEach(li => {
			li.classList.remove('active');
			const a = li.querySelector('a');
			if (a?.getAttribute('href') === `#${current}`) {
				li.classList.add('active');
			}
		});
	});
</script>
